# ---------------------------------------------------------------------------
# QuantAnomalies — ignored paths
#
# Rule of thumb: if it can be regenerated (caches, builds, downloaded market
# data) or is personal to one machine (editor settings, secrets), it stays out.
# Sources, docs and the final PDFs are tracked.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo
.python-version
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.local
coverage/

# Downloaded market-data caches — regenerated from Yahoo/FRED on first run.
# The folder itself is kept via .gitkeep so the app has somewhere to write.
backend/data/raw/*
!backend/data/raw/.gitkeep

# Local model weights — far too large for git, fetched separately.
*.gguf
*.safetensors
*.bin

# LaTeX build artifacts (the .tex sources and final .pdf are tracked)
*.aux
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
docs/_build_*.log

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets / environment (e.g. LLM_API_KEY for the decision engine)
.env
.env.*
!.env.example

# Tooling scratch — screenshots and MCP browser artifacts land at the repo root.
# Anchored with a leading slash so real assets like src/assets/hero.png survive.
.playwright-mcp/
/*.png
/*.jpg
/*.jpeg

# ---------------------------------------------------------------------------
# AI / editor tooling state — never belongs in this repo.
#
# These were previously only covered by machine-local files (a global gitignore
# and .git/info/exclude), neither of which is committed. That works on one
# machine and silently fails for everyone else who clones, so the rules live
# here instead. Anything a tool generates about the project is disposable; only
# the project itself is tracked.
# ---------------------------------------------------------------------------
.claude/
.impeccable/
.remember/
.cursor/
.windsurf/
.aider*
.continue/
.mcp.json

# Personal study notes — private learning material, not part of the deliverable
local/

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
